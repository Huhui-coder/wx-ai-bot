{
  "name": "weixin-lite-assistant",
  "version": "0.7.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "住在微信里的赛博女友：自定义人格 + 语音 + 生图 + 本机工具",
  "engines": { "node": ">=22.13.0" },
  "bin": { "weixin-lite": "bin/weixin-lite.js" },
  "files": ["bin/", "src/", "public/", "README.md", "LICENSE"],
  "scripts": {
    "start": "node bin/weixin-lite.js",
    "stop": "node bin/weixin-lite.js stop",
    "status": "node bin/weixin-lite.js status",
    "build:binary": "node scripts/build-binary.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/launcher.js && node --check public/app.js"
  },
  "dependencies": { "iconv-lite": "0.7.3", "qrcode": "^1.5.4", "unpdf": "2.1.0", "yaml": "^2.8.1" }
}
